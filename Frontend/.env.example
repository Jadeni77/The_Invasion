# Where the frontend should reach the backend.
#
# Vite only exposes variables prefixed with VITE_ to client code, and it reads
# them at BUILD time - changing this after `npm run build` has no effect, the
# build has to be repeated.
#
# Leave it unset for local development: src/config/api.js falls back to
# http://localhost:8080, which is where `cd Backend && ./mvnw spring-boot:run`
# serves. A production build with this unset logs an error at startup rather than
# failing quietly at the first request.
#
# No trailing slash needed - one is stripped if present.
VITE_API_BASE_URL=https://api.your-domain.example
